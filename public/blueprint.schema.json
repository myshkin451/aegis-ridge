{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARS-01 v2.0 工程配置",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "roomChanges", "scenario", "people", "time", "isolatedId", "lockdownSeconds"],
  "properties": {
    "version": { "const": "2.0" },
    "roomChanges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "b1_gym": { "enum": ["battery-bank", "listening-room", "materials-recovery"] },
        "b1_tactical": { "const": "staple-farm", "description": "工程试装，保留东北干区违规诊断。" },
        "b2_library": { "const": "listening-room" },
        "b3_aquaponics": { "const": "staple-farm" },
        "b3_foodproc": { "const": "staple-farm" }
      }
    },
    "scenario": { "enum": ["normal", "cryo", "bio", "fallout"] },
    "people": { "type": "integer", "minimum": 5, "maximum": 14 },
    "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "isolatedId": {
      "type": ["null", "string"], "minLength": 1, "maxLength": 128,
      "description": "当前配置下存在的设备位号或管段 ID。导入时用替换后的实际设备表与管网拓扑复核。"
    },
    "lockdownSeconds": { "type": "integer", "minimum": 0, "maximum": 30 }
  },
  "if": { "properties": { "scenario": { "enum": ["normal", "cryo"] } } },
  "then": { "properties": { "lockdownSeconds": { "const": 0 } } }
}
